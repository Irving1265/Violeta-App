# Copia este archivo a .env y llena tus datos reales
SECRET_KEY=pon_aqui_una_clave_larga_y_aleatoria

# Base de datos
# Local (desarrollo):
# DATABASE_URL=sqlite:////ruta/completa/a/instance/instagram_clone.db
#
# Producción (PostgreSQL administrado):
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/violeta
DATABASE_URL=
DATABASE_REQUIRE_SSL=true
DATABASE_SSLMODE=require
RUN_STARTUP_SCHEMA_SYNC=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800

# Cache compartido opcional para producción (recomendado en web/App Store backend)
# Si configuras Redis, el backend compartirá caché entre procesos/instancias.
REDIS_URL=
CACHE_NAMESPACE=violeta

# Archivos publicos (posts, fotos de perfil, adjuntos de chat)
# Local: deja UPLOAD_BACKEND=local
# Render/produccion: usa un bucket publico de Supabase Storage
UPLOAD_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Correo
# Local / SMTP
MAIL_DELIVERY_METHOD=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu_correo@ejemplo.com
MAIL_PASSWORD=tu_password_o_app_password
MAIL_DEFAULT_SENDER=tu_correo@ejemplo.com

# Producción / Render Free: usa Resend por HTTPS para evitar el bloqueo SMTP
# MAIL_DELIVERY_METHOD=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# RESEND_FROM=Violeta <onboarding@resend.dev>
# RESEND_REPLY_TO=tu_correo@ejemplo.com
# RESEND_API_URL=https://api.resend.com/emails
