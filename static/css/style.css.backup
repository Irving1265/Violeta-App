:root {
    /* Brand Colors */
    --primary-color: #8b5cf6;
    /* Vibrant Violet */
    --primary-light: #a78bfa;
    /* Lighter Violet */
    --primary-dark: #7c3aed;
    /* Deep Violet */
    --accent-color: #f43f5e;
    /* Vibrant Rose */

    /* Dark Theme Colors */
    --bg-body: #13111C;
    /* Deep Dark Purple Background */
    --bg-surface: #1E1B2E;
    /* Lighter Purple Surface */
    --text-main: #E9E3EF;
    /* Off-white text */
    --text-secondary: #948B9C;
    /* Muted Purple/Gray text */
    --border-color: #2D2438;
    /* Dark Purple Border */

    /* Status Colors */
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --info: #3b82f6;

    /* Spacing & Layout */
    --header-height: 60px;
    --bottom-nav-height: 65px;
    --sidebar-width: 250px;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --radius-full: 9999px;

    /* Shadows (Adjusted for Dark Mode) */
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -4px rgba(0, 0, 0, 0.3);
    --shadow-up: 0 -4px 6px -1px rgba(0, 0, 0, 0.3);

    /* Transitions */
    --transition-fast: 0.2s ease;
    --transition-normal: 0.3s ease;
}

/* Reset & Base */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-body);
    color: var(--text-main);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    padding-bottom: calc(var(--bottom-nav-height) + 20px);
    /* Mobile default */
}

@media (min-width: 768px) {
    body {
        padding-bottom: 0;
        display: flex;
    }
}

a {
    text-decoration: none;
    color: inherit;
    transition: var(--transition-fast);
}

ul {
    list-style: none;
}

/* Typography */
h1,
h2,
h3,
h4,
h5,
h6 {
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.5em;
}

h1 {
    font-size: 1.75rem;
}

h2 {
    font-size: 1.5rem;
}

h3 {
    font-size: 1.25rem;
}

p {
    margin-bottom: 1rem;
    color: var(--text-secondary);
}

/* Layout Utilities */
.app-layout {
    display: flex;
    min-height: 100vh;
    width: 100%;
}

.sidebar {
    display: none;
    width: var(--sidebar-width);
    background: var(--bg-surface);
    border-right: 1px solid var(--border-color);
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    padding: 1.5rem;
    flex-direction: column;
    z-index: 1000;
}

.main-content {
    width: 100%;
    padding: 1rem;
    max-width: 1200px;
    margin: 0 auto;
}

@media (min-width: 768px) {
    .sidebar {
        display: flex;
    }

    .bottom-nav {
        display: none !important;
    }

    .main-content {
        margin-left: var(--sidebar-width);
        width: calc(100% - var(--sidebar-width));
        padding: 2rem;
        max-width: none;
        /* Allow full width minus sidebar */
    }
}

/* Override main-content margin when sidebar is hidden */
.main-content.no-sidebar {
    margin-left: 0 !important;
    width: 100% !important;
    padding: 0 !important;
}

/* Error message styling */
.violet-error {
    color: #ff4d4d;
    font-size: 0.875rem;
    margin-top: 6px;
    display: block;
}

/* Balanced spacing for errors */
.form-group.has-error .input-icon-wrapper {
    margin-bottom: 8px;
}

.form-group.has-error .violet-error {
    margin-top: 0;
    margin-bottom: 8px;
}

.violet-error::before {
    content: '* ';
    font-weight: bold;
}

/* Components */

/* Logo */
.brand-logo {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary-color);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* Sidebar Nav */
.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.sidebar-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-weight: 500;
    transition: var(--transition-fast);
}

.sidebar-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
}

.sidebar-link.active {
    background: rgba(139, 92, 246, 0.15);
    color: var(--primary-light);
    font-weight: 600;
    border-left: 3px solid var(--primary-color);
}

.sidebar-link i {
    font-size: 1.25rem;
    width: 24px;
    text-align: center;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    border: none;
    transition: all var(--transition-fast);
    gap: 0.5rem;
}

.btn-primary {
    background-color: var(--primary-color);
    color: white;
    box-shadow: var(--shadow-md);
}

.btn-primary:hover {
    background-color: var(--primary-dark);
    transform: translateY(-1px);
    box-shadow: var(--shadow-lg);
    color: white;
}

.btn-secondary {
    background-color: transparent;
    color: var(--text-main);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--text-secondary);
}

.btn-ghost {
    background: transparent;
    color: var(--text-secondary);
}

.btn-ghost:hover {
    color: var(--primary-color);
    background-color: rgba(109, 40, 217, 0.05);
}

/* Cards */
.card {
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
    overflow: hidden;
    margin-bottom: 1.5rem;
}

.card-header {
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-color);
    background: transparent;
}

.card-body {
    padding: 1rem;
}

.card-footer {
    padding: 0.75rem 1rem;
    background: var(--bg-body);
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* Avatar */
.avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--bg-surface);
    box-shadow: var(--shadow-sm);
}

.avatar.sm {
    width: 32px;
    height: 32px;
}

.avatar.lg {
    width: 64px;
    height: 64px;
}

.avatar.xl {
    width: 96px;
    height: 96px;
}

/* Navigation (Mobile Bottom) */
.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--bottom-nav-height);
    background: rgba(30, 27, 46, 0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 1000;
    box-shadow: var(--shadow-up);
    padding-bottom: env(safe-area-inset-bottom);
}

.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-size: 1.5rem;
    padding: 0.5rem;
    position: relative;
    transition: var(--transition-fast);
}

.nav-item.active {
    color: var(--primary-color);
}

.nav-item.active::after {
    content: '';
    position: absolute;
    bottom: 5px;
    width: 4px;
    height: 4px;
    background: var(--primary-color);
    border-radius: 50%;
}

.nav-item.center {
    background: var(--primary-color);
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    transform: translateY(-15px);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    justify-content: center;
}

.nav-item.center:hover {
    transform: translateY(-18px);
    background: var(--primary-dark);
}

/* Forms */
.form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 1rem;
    transition: var(--transition-fast);
    background: var(--bg-surface);
}

.form-control:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.1);
}

/* Alerts */
.alert {
    padding: 1rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    border: 1px solid transparent;
    font-weight: 500;
}

.alert-success {
    background: #dcfce7;
    color: #166534;
    border-color: #bbf7d0;
}

.alert-danger {
    background: #fee2e2;
    color: #991b1b;
    border-color: #fecaca;
}

.alert-info {
    background: #dbeafe;
    color: #1e40af;
    border-color: #bfdbfe;
}

/* Utilities */
.text-primary {
    color: var(--primary-color) !important;
}

.text-muted {
    color: var(--text-secondary) !important;
}

.fw-bold {
    font-weight: 700 !important;
}

.d-flex {
    display: flex !important;
}

.align-items-center {
    align-items: center !important;
}

.justify-content-between {
    justify-content: space-between !important;
}

.gap-2 {
    gap: 0.5rem;
}

.mt-3 {
    margin-top: 1rem !important;
}

.mb-3 {
    margin-bottom: 1rem !important;
}

.d-none {
    display: none !important;
}

.d-md-flex {
    display: flex !important;
}

.d-md-none {
    display: none !important;
}

/* Map Container */
#map {
    width: 100%;
    height: 300px;
    border-radius: var(--radius-md);
    overflow: hidden;
    z-index: 1;
}

/* Feed Layout */
.feed-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
}

@media (min-width: 1024px) {
    .feed-layout {
        grid-template-columns: 1fr 320px;
    }
}

/* Widgets */
.widget-card {
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
    overflow: hidden;
}

.widget-header {
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
    font-weight: 700;
    font-size: 1.1rem;
}

.widget-content {
    padding: 1rem;
}

/* Trends */
.trend-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-color);
}

.trend-item:last-child {
    border-bottom: none;
}

.trend-tag {
    font-weight: 600;
    color: var(--primary-color);
}

.trend-count {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

/* FAB (Floating Action Button) */
.fab {
    position: fixed;
    bottom: calc(var(--bottom-nav-height) + 20px);
    right: 20px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent-color);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: var(--shadow-lg);
    z-index: 1050;
    transition: transform var(--transition-fast);
    border: none;
    cursor: pointer;
}

.fab:hover {
    transform: scale(1.1);
    background: #e11d48;
    /* Darker rose */
}

@media (min-width: 768px) {
    .fab {
        bottom: 40px;
        right: 40px;
    }
}

/* Post Card Specifics */
.post-image {
    width: 100%;
    height: auto;
    display: block;
    max-height: 600px;
    object-fit: cover;
}

.post-actions {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 1rem;
}

.action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
    color: var(--text-main);
    transition: color var(--transition-fast);
    padding: 0;
}

.action-btn:hover,
.action-btn.active {
    color: var(--accent-color);
}

.post-caption {
    padding: 0 1rem 1rem;
}

/* Profile Edit Page */
.edit-profile-container {
    max-width: 600px;
    margin: 40px auto;
    padding: 0 20px;
}

.edit-profile-card {
    background: rgba(30, 30, 40, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.avatar-uploader {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 30px;
    cursor: pointer;
    border-radius: 50%;
}

.avatar-uploader img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--primary-color);
    transition: filter 0.3s ease;
}

.avatar-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    color: white;
    font-size: 1.5rem;
}

.avatar-uploader:hover .avatar-overlay {
    opacity: 1;
}

.bio-label {
    display: block;
    margin-bottom: 10px;
    color: var(--text-secondary);
    font-weight: 500;
}

.bio-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 15px;
    color: var(--text-main);
    font-size: 1rem;
    resize: vertical;
    min-height: 120px;
    transition: all 0.3s ease;
}

.bio-input:focus {
    outline: none;
    border-color: var(--primary-color);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 4px rgba(181, 101, 167, 0.1);
}

.bio-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.edit-actions {
    display: flex;
    gap: 15px;
    margin-top: 40px;
    justify-content: flex-end;
}

/* Cropper Modal Customization */
.cropper-modal-dark .modal-content {
    background: #1e1e28;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-main);
}

.cropper-modal-dark .modal-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.cropper-modal-dark .modal-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.cropper-modal-dark .btn-close {
    filter: invert(1);
}

/* Profile Styles */
.profile-header {
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    overflow: hidden;
    margin-bottom: 2rem;
}

.profile-cover {
    height: 150px;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
}

.profile-info {
    padding: 0 2rem 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.profile-avatar-lg {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid var(--bg-surface);
    margin-top: -60px;
    margin-bottom: 1rem;
    object-fit: cover;
    background: var(--bg-surface);
    box-shadow: var(--shadow-md);
}

.profile-stats {
    display: flex;
    gap: 2rem;
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    width: 100%;
    justify-content: center;
}

.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-value {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--text-main);
}

.stat-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.profile-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
}

@media (min-width: 768px) {
    .profile-info {
        flex-direction: row;
        align-items: flex-end;
        text-align: left;
        padding-bottom: 1.5rem;
        gap: 2rem;
    }

    .profile-avatar-lg {
        margin-bottom: 0;
    }

    .profile-details {
        flex: 1;
        padding-bottom: 0.5rem;
    }

    .profile-stats {
        width: auto;
        border: none;
        margin: 0;
        padding: 0;
    }

    .profile-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }
}

.grid-item {
    aspect-ratio: 1;
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
}

.grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
}

.grid-item:hover img {
    transform: scale(1.05);
}

.grid-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-fast);
    color: white;
    font-weight: 600;
    gap: 1rem;
}

.grid-item:hover .grid-overlay {
    opacity: 1;
}

/* Detail View */
/* Legacy / Compatibility Styles */
.vio-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1rem;
}

.vio-cover {
    height: 100px;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
}

.vio-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
}

.vio-sub {
    font-size: 0.875rem;
    color: var(--text-secondary);
}

.vio-chip-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.violet-chips-container {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
}

.violet-chip {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    white-space: nowrap;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.violet-chip.active,
.violet-chip:hover {
    background: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
}

.avatar-lg {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid var(--bg-surface);
    box-shadow: var(--shadow-md);
    margin: -48px auto 1rem;
    background: var(--bg-surface);
    position: relative;
}

.avatar-lg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Fix for profile edit uploader */
.uploader {
    text-align: center;
    margin-bottom: 2rem;
}

.uploader-ctrls {
    margin-top: 1rem;
}

.uploader-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
}

.uploader-btn:hover {
    background: var(--bg-body);
}

.bio-area {
    width: 100%;
    background: var(--bg-body);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 1rem;
    border-radius: var(--radius-sm);
    resize: vertical;
}

.bio-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
}

.edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 2rem;
}

.btn-cancel {
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 1rem;
}

.btn-save {
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 0.5rem 1.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
}

.btn-save:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* Violeta Header & Search Redesign */
.violeta-header {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem;
    position: sticky;
    top: 0;
    z-index: 1020;
    box-shadow: var(--shadow-md);
    /* Break out of main-content padding */
    margin: -1rem -1rem 1rem -1rem;
    width: calc(100% + 2rem);
}

@media (min-width: 768px) {
    .violeta-header {
        margin: -2rem -2rem 2rem -2rem;
        width: calc(100% + 4rem);
    }
}

.violeta-header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
}

.violeta-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary-color);
    margin: 0;
}

.violeta-header-actions {
    display: flex;
    gap: 1rem;
}

.violeta-header-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    transition: all var(--transition-fast);
    border: 1px solid var(--border-color);
}

.violeta-header-btn:hover {
    background: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
    transform: translateY(-2px);
}

/* Search Section */
.violeta-search-section {
    margin-bottom: 1rem;
}

.violeta-search-container {
    display: flex;
    align-items: center;
    background: var(--bg-body);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 0.5rem 1rem;
    gap: 0.5rem;
    transition: border-color var(--transition-fast);
}

.violeta-search-container:focus-within {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
}

.violeta-search-icon {
    color: var(--text-secondary);
}

.violeta-search-input {
    background: transparent;
    border: none;
    color: var(--text-main);
    flex: 1;
    font-size: 0.95rem;
    outline: none;
}

.violeta-search-input::placeholder {
    color: var(--text-secondary);
}

.violeta-filter-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color var(--transition-fast);
}

.violeta-filter-btn:hover {
    color: var(--primary-color);
}

/* Chips Section */
.violeta-chips-section {
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin: 0 -1rem;
    /* Negative margin to allow full-width scroll */
    padding-left: 1rem;
    padding-right: 1rem;
    scrollbar-width: none;
    /* Firefox */
}

.violeta-chips-section::-webkit-scrollbar {
    display: none;
    /* Chrome/Safari */
}

.violeta-chips-container {
    display: flex;
    gap: 0.5rem;
}

.violeta-chip {
    background: var(--bg-body);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.violeta-chip:hover {
    border-color: var(--primary-light);
    color: var(--text-main);
}

.violeta-chip.active {
    background: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
    box-shadow: 0 2px 8px rgba(139, 92, 246, 0.4);
}

/* Admin Panel Redesign */
.admin-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
}

.admin-header-section {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid var(--border-color);
    text-align: center;
    box-shadow: var(--shadow-md);
}

.admin-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
}

.admin-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
}

/* Stats Grid */
.admin-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
}

.admin-stat-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.admin-stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-light);
}

.admin-stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.1);
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
}

.admin-stat-info {
    flex: 1;
}

.admin-stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
}

.admin-stat-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
}

/* Admin Sections */
.admin-section {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    margin-bottom: 2rem;
    overflow: hidden;
}

.admin-section-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.admin-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.admin-actions {
    display: flex;
    gap: 0.75rem;
}

/* Admin Tables */
.admin-table-container {
    overflow-x: auto;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
}

.admin-table th {
    background: rgba(0, 0, 0, 0.2);
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.admin-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-main);
    vertical-align: middle;
}

.admin-table tr:last-child td {
    border-bottom: none;
}

.admin-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
}

/* Admin Posts Grid */
.admin-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    padding: 1.5rem;
}

.admin-post-card {
    background: var(--bg-body);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-fast);
}

.admin-post-card:hover {
    border-color: var(--primary-light);
    transform: translateY(-2px);
}

.admin-post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.admin-post-content {
    padding: 1rem;
}

.admin-post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
}

.admin-post-caption {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.admin-post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
}

.admin-badge {
    background: var(--primary-color);
    color: white;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
}

/* Premium Admin Panel Redesign */
.admin-container {
    width: 100%;
    min-height: 100vh;
    padding: 0;
    margin: 0;
}

/* Update admin wrapper for new design */
.admin-wrapper {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
}

/* Redesigned admin header */
.admin-header-section {
    background: linear-gradient(135deg, var(--primary-color) 0%, #6b21a8 100%);
    padding: 3rem 2rem;
    margin-bottom: 3rem;
    border-radius: 0;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.admin-header-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.1) 0%, transparent 60%);
    pointer-events: none;
}

.admin-header-section .admin-title {
    position: relative;
    font-size: 2.5rem;
    font-weight: 900;
    color: white;
    margin-bottom: 0.75rem;
    text-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
}

.admin-header-section .admin-subtitle {
    position: relative;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 400;
}

/* Enhanced stats grid */
.admin-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
}

.admin-stat-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.admin-stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--primary-color), var(--primary-light));
    opacity: 0;
    transition: opacity 0.3s ease;
}

.admin-stat-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 12px 40px rgba(139, 92, 246, 0.2);
    border-color: var(--primary-light);
}

.admin-stat-card:hover::before {
    opacity: 1;
}

.admin-stat-icon {
    width: 70px;
    height: 70px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.05));
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.admin-stat-card:hover .admin-stat-icon {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.25), rgba(139, 92, 246, 0.15));
    transform: scale(1.1) rotate(-5deg);
}

.admin-stat-info {
    flex: 1;
    min-width: 0;
}

.admin-stat-number {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.admin-stat-label {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Tab navigation */
.admin-tabs {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--border-color);
    padding: 0 0.5rem;
}

.admin-tab {
    padding: 1rem 2rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
}

.admin-tab:hover {
    color: var(--text-main);
}

.admin-tab.active {
    color: var(--primary-color);
    border-bottom-color: var(--primary-color);
}

.admin-tab-content {
    display: none;
}

.admin-tab-content.active {
    display: block;
}

/* Enhanced sections */
.admin-section {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    margin-bottom: 2rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}

.admin-section-header {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.02);
}

.admin-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-main);
}

.admin-section-title i {
    font-size: 1.1rem;
}

.admin-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

/* Modern table */
.admin-table-container {
    overflow-x: auto;
    padding: 1.5rem;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
}

.admin-table thead {
    position: sticky;
    top: 0;
    z-index: 10;
}

.admin-table th {
    background: var(--bg-body);
    padding: 1rem 1.5rem;
    text-align: left;
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid var(--border-color);
}

.admin-table td {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-main);
    vertical-align: middle;
}

.admin-table tbody tr {
    transition: all 0.2s ease;
}

.admin-table tbody tr:hover {
    background: rgba(139, 92, 246, 0.05);
}

.admin-table tbody tr:last-child td {
    border-bottom: none;
}

/* Posts grid enhancement */
.admin-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    padding: 1.5rem;
}

.admin-post-card {
    background: var(--bg-body);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.admin-post-card:hover {
    border-color: var(--primary-light);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
}

.admin-post-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
}

.admin-post-content {
    padding: 1.25rem;
}

.admin-post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.admin-post-caption {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
}

.admin-post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    margin-top: auto;
}

/* Admin badge */
.admin-badge {
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    color: white;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Responsive */
@media (max-width: 768px) {
    .admin-header-section {
        padding: 2rem 1rem;
    }

    .admin-header-section .admin-title {
        font-size: 2rem;
    }

    .admin-stats-grid {
        grid-template-columns: 1fr;
    }

    .admin-tabs {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .admin-tab {
        white-space: nowrap;
    }

    .admin-section-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .admin-posts-grid {
        grid-template-columns: 1fr;
    }
}

/* Premium Admin Hero Header */
.admin-hero {
    background: linear-gradient(135deg, #8b5cf6 0%, #6b21a8 50%, #581c87 100%);
    padding: 4rem 2rem;
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
}

.admin-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    border-radius: 50%;
}

.admin-hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
    border-radius: 50%;
}

.admin-hero-content {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    position: relative;
    z-index: 1;
}

.admin-hero-text {
    flex: 1;
}

.admin-hero-title {
    font-size: 3rem;
    font-weight: 900;
    color: white;
    margin-bottom: 1rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    line-height: 1.1;
}

.admin-hero-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    font-weight: 400;
}

/* Enhanced tabs */
.admin-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--border-color);
    padding: 0;
    overflow-x: auto;
}

.admin-tab {
    padding: 1rem 2rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    white-space: nowrap;
}

.admin-tab:hover {
    color: var(--text-main);
    background: rgba(139, 92, 246, 0.05);
}

.admin-tab.active {
    color: var(--primary-color);
    border-bottom-color: var(--primary-color);
    background: rgba(139, 92, 246, 0.08);
}

.admin-tab i {
    opacity: 0.7;
}

.admin-tab.active i {
    opacity: 1;
}

/* Tab Content */
.admin-tab-content {
    display: none;
    animation: fadeIn 0.3s ease;
}

.admin-tab-content.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .admin-hero {
        padding: 3rem 1.5rem;
    }

    .admin-hero-content {
        flex-direction: column;
        text-align: center;
    }

    .admin-hero-title {
        font-size: 2rem;
    }

    .admin-hero-subtitle {
        font-size: 1rem;
    }

    .admin-tabs {
        padding: 0 0.5rem;
    }

    .admin-tab {
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
    }
}

/* --- Landing Page Redesign --- */
.landing-page {
    min-height: 100vh;
    background: var(--bg-body);
    overflow: hidden;
    position: relative;
}

.landing-split {
    display: flex;
    height: 100vh;
    width: 100%;
    overflow: hidden;
}

/* Left Side: Auth */
.landing-auth {
    width: 35%;
    min-width: 380px;
    background: var(--bg-body);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    position: relative;
    z-index: 20;
    /* Ensure it stays on top of map */
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.2);
}

.auth-container {
    width: 100%;
    max-width: 400px;
}

.brand-section {
    margin-bottom: 40px;
    text-align: center;
}

.brand-title {
    font-size: 3.5rem;
    font-weight: 900;
    letter-spacing: -2px;
    background: linear-gradient(135deg, #fff 0%, #d6a4d8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
    line-height: 1;
}

.brand-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-top: 10px;
    font-weight: 500;
}

/* Glass Panel */
.glass-panel {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    padding: 32px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
}

.auth-header {
    text-align: center;
    margin-bottom: 30px;
}

.auth-header .avatar-ilu {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin-bottom: 16px;
    border: 3px solid #b565a7;
    padding: 3px;
    background: transparent;
}

.auth-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
}

/* Form Elements */
.input-icon-wrapper {
    position: relative;
    margin-bottom: 16px;
}

.input-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

/* Global violet-input styling */
.violet-input {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: var(--text-main);
    font-size: 1rem;
    transition: all 0.3s ease;
    outline: none;
}

.violet-input::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
}

.violet-input:focus {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--primary-color);
    box-shadow: 0 0 0 4px rgba(181, 101, 167, 0.1);
}

/* Landing page specific override for icon padding */
.landing-auth .violet-input {
    padding-left: 45px;
    background: rgba(0, 0, 0, 0.2);
}

/* Add padding for inputs with left icons */
.input-icon-wrapper .violet-input {
    padding-left: 45px;
}

.landing-auth .violet-input:focus {
    background: rgba(0, 0, 0, 0.4);
}

.violet-input.error {
    border-color: #ff4d4d !important;
    box-shadow: 0 0 0 4px rgba(255, 77, 77, 0.1) !important;
}

.violet-input.error:focus {
    border-color: #ff4d4d !important;
    box-shadow: 0 0 0 4px rgba(255, 77, 77, 0.2) !important;
}

.pwd-toggle {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

.form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    font-size: 0.9rem;
    width: 100%;
    gap: 16px;
    flex-wrap: wrap;
}

/* Global violet-btn-primary styling */
.violet-btn-primary {
    background: linear-gradient(135deg, #b565a7 0%, #8a5a9d 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 14px 24px;
    font-weight: 600;
    font-size: 1rem;
    color: #fff;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: none;
    letter-spacing: 0.3px;
    box-shadow: 0 4px 15px rgba(181, 101, 167, 0.3);
    position: relative;
    overflow: hidden;
}

.violet-btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
}

.violet-btn-primary:hover::before {
    left: 100%;
}

.violet-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(181, 101, 167, 0.5);
    background: linear-gradient(135deg, #c78cc4 0%, #a067af 100%);
}

.violet-btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 2px 10px rgba(181, 101, 167, 0.3);
}

/* Landing page override */
.landing-auth .violet-btn-primary {
    width: 100%;
    padding: 16px;
    font-size: 1.1rem;
}

.remember-me {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    cursor: pointer;
}

.link-muted {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
}

.link-muted:hover {
    color: var(--primary-color);
}

.auth-footer {
    margin-top: 24px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 24px;
}

.auth-footer p {
    color: var(--text-secondary);
    margin-bottom: 12px;
    font-size: 0.9rem;
}

.btn-outline-sm {
    display: inline-block;
    padding: 8px 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.3s;
}

.btn-outline-sm:hover {
    border-color: var(--primary-color);
    background: rgba(181, 101, 167, 0.1);
    color: #fff;
}

/* Right Side: Map */
.landing-map-section {
    flex: 1;
    position: relative;
    background: #1a1a1a;
    z-index: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Ensure no overflow */
}

.full-map {
    width: 100%;
    height: 100%;
    flex: 1;
    /* Ensure it fills the flex container */
    filter: brightness(0.8) contrast(1.1);
}

.map-overlay-gradient {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 150px;
    background: linear-gradient(to right, var(--bg-body), transparent);
    pointer-events: none;
    z-index: 5;
}

.map-controls-overlay {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
}

.glass-panel-sm {
    background: rgba(20, 20, 30, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    width: 300px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.card-header-sm {
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.card-header-sm:hover {
    background: rgba(255, 255, 255, 0.05);
}

.toggle-icon {
    margin-left: auto;
    transition: transform 0.3s;
}

.card-body-sm {
    padding: 16px;
}

/* Mobile Responsive */
@media (max-width: 992px) {
    .landing-split {
        flex-direction: column;
        height: auto;
        min-height: 100vh;
    }

    .landing-auth {
        width: 100%;
        min-width: 0;
        padding: 30px 20px;
        min-height: auto;
    }

    .landing-map-section {
        height: 50vh;
        min-height: 400px;
    }

    .map-overlay-gradient {
        width: 100%;
        height: 100px;
        background: linear-gradient(to bottom, var(--bg-body), transparent);
    }

    .map-controls-overlay {
        top: auto;
        bottom: 20px;
        right: 20px;
        left: 20px;
        align-items: center;
    }

    .glass-panel-sm {
        width: 100%;
        max-width: 400px;
    }
}

/* Register Page */
.register-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: var(--bg-body);
}

.register-card {
    width: 100%;
    max-width: 450px;
    background: rgba(30, 30, 40, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    position: relative;
    overflow: hidden;
}

.register-header {
    text-align: center;
    margin-bottom: 30px;
}

.register-title {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #fff 0%, #d6a4d8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 10px;
}

.step-indicator {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 30px;
}

.step-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
}

.step-dot.active {
    background: var(--primary-color);
    transform: scale(1.2);
}

.step-dot.completed {
    background: var(--primary-color);
}

.register-step {
    display: none;
    animation: fadeIn 0.4s ease;
}

.register-step.active {
    display: block;
}

.step-heading {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: var(--text-main);
    text-align: center;
}

.password-requirements {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 15px;
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.password-requirements ul {
    padding-left: 20px;
    margin-bottom: 0;
}

.password-requirements li {
    margin-bottom: 4px;
    color: #ff4d4d;
    transition: color 0.3s;
}

.password-requirements li.valid {
    color: #4caf50;
}

.password-requirements li.valid .req-icon {
    color: #4caf50;
}

.password-requirements li .req-icon {
    color: #ff4d4d;
    margin-right: 8px;
    font-size: 0.9rem;
}

.password-requirements li.valid .req-icon::before {
    content: "\f00c";
    /* checkmark */
}


.back-btn {
    position: absolute;
    top: 20px;
    left: 20px;
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s;
    padding: 5px;
}

.back-btn:hover {
    color: var(--text-main);
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 3D Flip Animation */
.post-content-container {
    position: relative;
    width: 100%;
    transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-style: preserve-3d;
}

.post-content-container.flipped {
    transform: rotateY(180deg);
}

.face-front,
.face-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
}

.face-front {
    position: relative;
    z-index: 2;
    transform: rotateY(0deg);
}

.face-back {
    transform: rotateY(180deg);
    z-index: 1;
    background: #eee;
}

/* Ensure map fills the back face */
.post-map-wrapper {
    display: block;
}

/* Post Categories Badges */
.violet-badge {
    display: inline-block;
    background: rgba(139, 92, 246, 0.15);
    color: #a78bfa;
    border: 1px solid rgba(139, 92, 246, 0.3);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-right: 6px;
    margin-bottom: 6px;
    transition: all 0.2s ease;
}

.violet-badge:hover {
    background: rgba(139, 92, 246, 0.25);
    transform: translateY(-1px);
}

/* Enhanced Comments Section */
.comment-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
    animation: fadeIn 0.3s ease;
}

.comment-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(139, 92, 246, 0.3);
    flex-shrink: 0;
}

.comment-bubble {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 8px 14px;
    border-radius: 18px;
    border-top-left-radius: 4px;
    flex: 1;
}

.comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.comment-author {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--text-main);
    text-decoration: none;
}

.comment-author:hover {
    text-decoration: underline;
}

.comment-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
    word-break: break-word;
}

.comments-list::-webkit-scrollbar {
    width: 4px;
}

.comments-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}